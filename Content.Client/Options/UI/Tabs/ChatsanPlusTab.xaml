

<Control xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:s="clr-namespace:Content.Client.Stylesheets"
         xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
         xmlns:ui="clr-namespace:Content.Client.Options.UI">
    <BoxContainer Orientation="Vertical">
        <BoxContainer Orientation="Horizontal"
                      Margin="0 10 20 5">
            <Label Text="{Loc 'ui-options-binds-search'}"
                   Margin="15 5 15 5"
                   FontColorOverride="{x:Static s:StyleNano.NanoGold}"
                   />
            <LineEdit Name="SearchInput"  HorizontalExpand="True" SizeFlagsStretchRatio="2"/>
        </BoxContainer>

        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="ShortsContainer" Orientation="Vertical" Margin="8 8 8 8">

                <!-- Shorts buttons are added here in the C# code -->

            </BoxContainer>
        </ScrollContainer>



        <controls:StripeBack HasBottomEdge="False">
            <BoxContainer Orientation="Horizontal" Align="End" Margin="2">

                <Label Text="Ввод - личный ключ, который заменяется при выводе. Вывод - преобразованный ключ, который увидят все." StyleClasses="LabelSubText" />

            </BoxContainer>
        </controls:StripeBack>

        <controls:StripeBack HasBottomEdge="False">
            <BoxContainer Orientation="Horizontal" Align="End" Margin="2">
                <Button Name="DefaultButton"
                        Text="{Loc 'ui-options-default'}"
                        TextAlign="Center"
                        Margin="8 0" />

                <Button Name="ApplyButton"
                        Text="{Loc 'ui-options-apply'}"
                        StyleClasses="OpenLeft" />

                <Button Name="AddNewButton"
                            Text="Добавить"
                            HorizontalExpand="True"
                            Margin ="50 0 0 0"
                            HorizontalAlignment="Right" />
                
            </BoxContainer>
        </controls:StripeBack>
    </BoxContainer>
</Control>
